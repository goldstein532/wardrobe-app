# Токен бота из @BotFather
BOT_TOKEN=

# Username бота и короткое имя Mini App (t.me/<BOT_USERNAME>/<APP_NAME>)
BOT_USERNAME=
APP_NAME=shop

# Каналы-источники (username без @ или числовой id)
CHANNEL_MAIN=nasonchikh_wardrobe
CHANNEL_TRANSIT=

# Куда ведёт кнопка «Купить / вопрос», если в посте нет своей ссылки
ADMIN_USERNAME=nasonchikh_mngr

# Telegram user_id админов через запятую (бот покажет по /whoami)
ADMIN_IDS=

# Для одноразового импорта истории (my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Ключ шифрования файла подписчиков
SUBSCRIBERS_KEY=
